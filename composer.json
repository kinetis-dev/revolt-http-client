{
    "name": "kinetis/revolt-http-client",
    "description": "A Revolt-native, Fiber-suspending implementation of Symfony's HttpClientInterface — usable standalone by any project (AsyncAws or otherwise), not only Kinetis.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/http-client": "^8.0",
        "symfony/http-client-contracts": "^3.7",
        "amphp/http-client": "^5.3"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "kinetis/kinetis": "dev-main",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\RevoltHttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\RevoltHttpClient\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../kinetis"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
