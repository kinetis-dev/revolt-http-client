{
    "name": "kinetis/revolt-http-client",
    "description": "A Revolt-native, Fiber-suspending implementation of Symfony's HttpClientInterface — usable standalone by any project (AsyncAws or otherwise), not only Kinetis.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/http-client": "^8.1.4",
        "symfony/http-client-contracts": "^3.7.1",
        "amphp/http-client": "^5.3.6",
        "revolt/event-loop": "^1.0.9"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/framework": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\RevoltHttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\RevoltHttpClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
